# ===== 复制本文件为 .env 并填入你自己的密钥 =====
# .env 不会被提交到 Git（已在 .gitignore 中）。

# 主分析模型：任意 OpenAI 兼容端点的 API Key
# 可用：通义千问(百炼) / DeepSeek / 智谱GLM / OpenAI 等。
DEEPSEEK_API_KEY=your_api_key_here

# 对应端点（按你选择的服务商修改）
# 通义千问(百炼)：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com
# OpenAI：https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主模型名
STOCKAI_FAST_MODEL=qwen-max

# 后端：deepseek(云端) / local(本地Ollama) / auto(云端优先，失败降级本地)
STOCKAI_LLM_BACKEND=deepseek

# ---- 可选：第二辩论模型（智谱GLM，免费，留空则不用）----
GLM_API_KEY=

# ---- 可选：新闻搜索 Tavily（留空则不启用）----
TAVILY_API_KEY=

# ===== 本地 AI 模型配置（可选，完全离线）=====
# 是否优先使用本地推理（true=优先本地，false=走云端/auto）
LOCAL_AI_ENABLED=false
# Ollama 拉取的本地模型名（如 MoziAI：ollama pull moziAI:35b）
OLLAMA_MODEL_NAME=moziAI:35b
# llama-cpp-python 直读的 GGUF 模型文件路径（留空=只用 Ollama 后端）
LOCAL_MODEL_PATH=
