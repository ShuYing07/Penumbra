Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\lnkfile]
@="Shortcut"
"EditFlags"=hex:01,00,00,00
"IsShortcut"=""

[HKEY_CLASSES_ROOT\exefile]
"EditFlags"=hex:00,00,00,00

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders]
"Desktop"="C:////Users////shuying////Desktop/ >> desktop_shortcut.reg && echo  >> desktop_shortcut.reg && echo [HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders] >> desktop_shortcut.reg && echo "Desktop"="C:////Users////shuying////Desktop/
